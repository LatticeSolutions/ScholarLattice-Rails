<nav aria-label="Breadcrumb" class="w-full px-4 py-3">
    <ol class="flex items-center gap-1 text-sm text-white drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.95)]">
        <% @crumbs.each_with_index do |crumb, i| %>
            <li>
                <span class="block transition flex gap-1 items-center justify-center">
                    <% if crumb.key? :link %>
                        <a href="<%= crumb[:link] %>" class="hover:text-gray-300 hover:font-medium gap-1 flex items-center justify-center">
                            <% if crumb.key? :icon and crumb[:icon].present? %>
                                <span class="inline-block size-5">
                                    <%= render IconComponent.new(crumb[:icon]) %>
                                </span>
                            <% end %>
                            <% if crumb.key? :text %>
                                <span class="text-gray-100"><%= crumb[:text] %></span>
                            <% end %>
                        </a>
                    <% else %>
                        <% if crumb.key? :icon and crumb[:icon].present? %>
                            <span class="inline-block size-5">
                                <%= render IconComponent.new(crumb[:icon]) %>
                            </span>
                        <% end %>
                        <% if crumb.key? :text %>
                            <span class="cursor-default text-gray-100"><%= crumb[:text] %></span>
                        <% end %>
                    <% end %>
                </span>
            </li>
            <% unless i+1 == @crumbs.length %>
                <li>
                    <span class="block size-4">
                        <%= render IconComponent.new(:chevron) %>
                    </span>
                </li>
            <% end %>
        <% end %>
    </ol>
</nav>
