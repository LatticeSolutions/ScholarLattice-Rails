<%= render "users/embed_login", 
      session: session,
      user: registration.user,
      email_disabled: ((@current_user.present? or session.present?) and cannot? :manage, collection),
      affiliation_identifier_alias: collection.affiliation_identifier_alias,
      form: form %>

<%= form.hidden_field :user_id, value: registration.user_id %>

<h2 class="font-bold text-2xl">Registration Info</h2>

<div class="my-5">
  <%= render "errors", object: registration, attribute: :user %>
  <%= form.label :registration_option_id, class: CssClass::LABEL %>
  <%= form.select :registration_option_id, collection.registration_options.map {|o| [o.name_with_cost_and_stock, o.id]},
      {
        selected: registration.registration_option_id || nil,
        disabled: (can? :manage, collection) ? [] : collection.registration_options.reject(&:in_stock?).map(&:id)
      },
      {class: CssClass::SELECT} %>
  <%= render "errors", object: registration, attribute: :registration_option_id %>
</div>

<% if can? :manage, collection %>
  <div class="my-5">
    <%= form.label :status, class: CssClass::LABEL do %>
      <span class="size-4 inline-block">
        <%= render IconComponent.new(:key) %>
      </span>
      Status
    <% end %>
    <%= form.select :status, Registration.statuses.keys.map {|key| [key.humanize, key]},
      {selected: registration.status || :draft},
      {class: CssClass::SELECT} %>
    <%= render "errors", object: registration, attribute: :status %>
  </div>
<% end %>
