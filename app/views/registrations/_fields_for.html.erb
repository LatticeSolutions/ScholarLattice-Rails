<%= form.fields_for :user, registration.user do |user_fields| %>
  <%= render "users/fields_for",
      user: registration.user,
      email_disabled: true,
      form: user_fields %>
<% end %>

<%= form.hidden_field :user_id, value: registration.user_id %>

<h2 class="font-bold text-2xl">Registration Info</h2>

<div class="my-5">
  <%= render "errors", object: registration, attribute: :user %>

  <%= render "errors", object: registration, attribute: :registration_option_choices %>

  <div x-data="{ limitOne: <%= 
    registration.collection.limit_one_registration_option? ? "true" : "false" 
    %>, selectedOption: '<%= 
    registration.registration_option_choices.select{|c| c.amount > 0}.first&.registration_option_id || "null" 
    %>' }">
    <% if registration.collection.limit_one_registration_option? %>
      <div class="mb-5">
        <%= label_tag :registration_option_id_choice, "Registration Option", class: CssClass::LABEL %>
        <%= select_tag :registration_option_id_choice, 
          options_for_select(
            registration.collection.registration_options.map{|ro| [ro.name_with_cost_and_availability, ro.id]},
            disabled: (can? :manage, collection) ? [] : collection.registration_options.reject(&:available?).map(&:id)
          ),
          {
            prompt: "Select an option",
            value: registration.registration_option_choices.select{|c| c.amount > 0}.first&.registration_option_id,
            class: CssClass::SELECT,
            "x-model" => "selectedOption"
          } %>
      </div>
    <% end %>

    <%= form.fields_for :registration_option_choices do |choice_fields| %>
      <div class="border rounded p-2 my-2 <%=
        choice_fields.object.registration_option.available_or_admin?(@current_user) ? " bg-white" : "bg-gray-100 cursor-not-allowed"
        %>" :class="{ 'hidden' : limitOne && selectedOption !== '<%= choice_fields.object.registration_option_id %>' }">
        <% if choice_fields.object.registration_option.limit_one_per_registration %>
          <% if registration.collection.limit_one_registration_option %>
            <%= choice_fields.hidden_field :amount, value: 1 %>
          <% else %>
            <div class="mb-5">
              <%= choice_fields.label :amount, class: CssClass::LABEL do %>
                <%= choice_fields.object.registration_option.name_with_cost_and_availability %> Registration
              <% end %>
              <%= choice_fields.check_box :amount, 
                class: CssClass::CHECK_BOX, 
                disabled: !choice_fields.object.registration_option.available_or_admin?(@current_user) %>
              <%= render "errors", object: choice_fields.object, attribute: :amount %>
            </div>
          <% end %>
        <% else %>
          <div class="mb-5">
            <%= choice_fields.label :amount, class: CssClass::LABEL do %>
                <%= choice_fields.object.registration_option.name_with_cost_and_availability %> Amount
            <% end %>
            <%= choice_fields.number_field :amount, 
              class: CssClass::NUMBER_FIELD,
              disabled: !choice_fields.object.registration_option.available_or_admin?(@current_user) %>
            <%= render "errors", object: choice_fields.object, attribute: :amount %>
          </div>
        <% end %>
        <% if choice_fields.object.registration_option.info_prompt.present? %>
          <div class="mb-5">
            <%= choice_fields.label :info, class: CssClass::LABEL do %>
              <%= choice_fields.object.registration_option.name %> Info
              <span class="<%= CssClass::SUBLABEL %>">
                <%= choice_fields.object.registration_option.info_prompt %>
              </span>
            <% end %>
            <%= choice_fields.text_field :info, 
              class: CssClass::TEXT_FIELD,
              disabled: !choice_fields.object.registration_option.available_or_admin?(@current_user) %>
            <%= render "errors", object: choice_fields.object, attribute: :info %>
          </div>
        <% else %>
          <%= choice_fields.hidden_field :info %>
        <% end %>
        <%= choice_fields.hidden_field :registration_option_id %>
      </div>
    <% end %>
  </div>

</div>

<% if can? :manage, collection %>
  <div class="my-5">
    <%= form.label :status, class: CssClass::LABEL do %>
      <span class="size-4 inline-block">
        <%= render IconComponent.new(:key) %>
      </span>
      Status
    <% end %>
    <%= form.select :status, Registration.statuses.keys.map {|key| [key.humanize, key]},
      {selected: registration.status || :submitted},
      {class: CssClass::SELECT} %>
    <%= render "errors", object: registration, attribute: :status %>
  </div>
<% end %>
