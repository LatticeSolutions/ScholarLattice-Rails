<% content_for :title, "Edit Registration | #{@registration.collection.title}" %>
<% content_for :breadcrumb do %>
    <%= render partial: "breadcrumb", locals: { collection: @collection, action: "Edit" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:registration) %>
    </span>
    <span>
      Edit Registration
    </span>
  </div>
<% end %>

  <% if can? :manage, @registration.collection %>
    <%= render "users/change_form", user: @registration.user, url: @registration, method: :patch %>
  <% end %>

  <%= render "form", registration: @registration, collection: @registration.collection %>
