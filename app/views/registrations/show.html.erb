<% content_for :title, "Registration for #{@registration.user.name} | #{@collection.title}" %>
<% content_for :breadcrumb do %>
  <%= render partial: "breadcrumb", locals: { collection: @registration.collection, action: "Details" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:registration) %>
    </span>
    <span>
      Registration for 
      <%= @registration.user.name_with_email %>, <%= @registration.user.affiliation %> 
      (<%= @registration.status.humanize %>)
      <% if can? :edit, @registration %>
        <%= link_to "[Update]", edit_registration_path(@registration), class: "text-blue-500 hover:underline" %>
      <% end %>
    </span>
  </div>
<% end %>
<% if can? :manage, @collection %>
  <% @buttons = [[
        "Admin",
        :key,
        true,
        {path: edit_registration_path(@registration), text: "Edit"},
        { 
            path: @registration, 
            text: "Delete registration",
            method: :delete,
            confirm: "Are you sure you want to delete this registration?",
            hidden: (cannot? :destroy, @registration),
            styles: "text-red-800"
        },
    ]] %>
<% end %>

    <% @registration.registration_option_choices.reject{|c| c.amount < 1}.each do |choice| %>
      <div class="border rounded bg-white p-5 mb-2">
        <h2 class="text-lg font-medium mb-2"><%= choice.registration_option.name_with_cost %> Registrations</h2>
        <p class="my-2">
          <strong class="font-medium mb-1">Amount:</strong>
          <%= choice.amount %>
        </p>
        <% if choice.info.present? %>
          <p class="my-2">
            <strong class="font-medium mb-1">Info:</strong>
            <%= choice.info %>
          </p>
        <% end %>
      </div>
    <% end %>


    <% if @registration.has_cost? %>
      <div class="my-5">
        <h2 class="text-lg font-medium mt-5 mb-2">Total Cost of Registrations:</h2>
        <span>$<%= Money.new(@registration.total_cost, :usd) %></span>
        <% if @registration.collection.paypal_link.present? %>
          <%= link_to "Pay Online with PayPal or Credit Card", 
            @registration.collection.paypal_link, 
            target: "_blank",
            class: "#{CssClass::LINK_BUTTON} bg-yellow-500 hover:bg-yellow-600 rounded text-white ml-3" %>
        <% end %>
      </div>
    <% end %>

