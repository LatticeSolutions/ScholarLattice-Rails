<% content_for :title, "Registrations | #{@collection.title}" %>
<% content_for :breadcrumb do %>
  <%= render partial: "breadcrumb", locals: { collection: @collection } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:registration) %>
    </span>
    <span>
      Registrations (<%= @registrations.count %>)
    </span>
  </div>
<% end %>

    <% if can? :manage, @collection %>
        <div class="py-2">
            <%= link_to "New Registration", new_collection_registration_path(@collection), class: "bg-blue-500 hover:bg-blue-700 text-white py-2 px-4 rounded" %>
            <%= link_to "Download CSV", collection_registrations_path(@collection, format: :csv), class: "bg-green-500 hover:bg-green-700 text-white py-2 px-4 rounded" %>
            <%= link_to "Upload Registrations", collection_registrations_upload_path(@collection), class: "bg-yellow-500 hover:bg-yellow-700 text-white py-2 px-4 rounded" %>
        </div>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl py-3">
            Submitted (<%= @registrations.where(status: :submitted).count %>):
        </h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
            <% @registrations.where(status: :submitted).each do |registration| %>
                <%= render partial: "registrations/card", locals: { registration: registration, collection: @collection } %>
            <% end %>
        </div>
        <div class="text-gray-700 py-3">
            Emails:
            <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
                @registrations.where(status: :submitted).map{|r| r.user.email }.join("; ")
            %></textarea>
        </div>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl py-3">
            Accepted (<%= @registrations.where(status: :accepted).count %>):
        </h2>
    <% end %>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
        <% @registrations.where(status: :accepted).each do |registration| %>
            <%= render partial: "registrations/card", locals: { registration: registration, collection: @collection } %>
        <% end %>
    </div>
    <% if can? :manage, @collection %>
        <div class="text-gray-700 py-3">
            Emails:
            <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
                @registrations.where(status: :accepted).map{|r| r.user.email }.join("; ")
            %></textarea>
        </div>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl py-3">
            Declined (<%= @registrations.where(status: :declined).count %>):
        </h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
            <% @registrations.where(status: :declined).each do |registration| %>
                <%= render partial: "registrations/card", locals: { registration: registration, collection: @collection } %>
            <% end %>
        </div>
        <div class="text-gray-700 py-3">
            Emails:
            <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
                @registrations.where(status: :declined).map{|r| r.user.email }.join("; ")
            %></textarea>
        </div>

        <h1 class="text-2xl font-bold text-gray-900 md:text-3xl py-5">
            Registration Options
        </h1>

        <div class="py-2">
            <%= link_to "New Option", new_collection_registration_option_path(@collection), class: "bg-sky-500 hover:bg-sky-700 text-white py-2 px-4 rounded" %>
        </div>
            
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8 my-4">
            <% @collection.registration_options.each do |option| %>
                <%= link_to registration_option_path(option), class: "block bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-50" do %>
                    <div class="p-4">
                        <h3 class="text-lg font-medium text-gray-900"><%= option.name %></h3>
                        <% if option.cost.present? %>
                            <p class="text-sm text-gray-500"><%= Money.from_cents(option.cost, :usd).format %> USD</p>
                        <% end %>
                    </div>
                <% end %>
            <% end %>
        </div>
    <% end %>
