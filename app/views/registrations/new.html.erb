<% content_for :title, "New Registration | #{@collection.title}" %>
<% content_for :breadcrumb do %>
  <%= render partial: "breadcrumb", locals: { collection: @collection, action: "New" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:registration) %>
    </span>
    <span>
      New Registration
    </span>
  </div>
<% end %>

  <% if can? :manage, @registration.collection %>
    <%= render "users/change_form", user: @registration.user, url: collection_registrations_path(@registration.collection), method: :post %>
  <% end %>

  <%= render "form", registration: @registration, collection: @collection %>
