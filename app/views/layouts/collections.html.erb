<% content_for :content do %>
<section class="w-full">
    <div class="flex flex-col">
        <!-- Cover Image -->
        <div class="bg-center bg-cover w-full xl:h-[20rem] lg:h-[18rem] md:h-[16rem] sm:h-[14rem] h-[11rem]"
            style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= image_path("chalkboard.jpg") %>')">
            <div class="w-full h-full relative text-white drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.95)]">
                <div class="absolute left-0 top-0">
                    <%= yield(:breadcrumb) %>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="sm:w-[80%] w-[90%] mx-auto flex">
            <%= image_tag "logo-square.png", alt: "logo", 
                class: "bg-white rounded-md drop-shadow-lg border-2 border-gray-300 lg:w-[12rem] lg:h-[12rem] md:w-[10rem] md:h-[10rem] sm:w-[8rem] sm:h-[8rem] w-[7rem] h-[7rem] relative lg:bottom-[5rem] sm:bottom-[4rem] bottom-[3rem]" %>

            <div class="w-full text-left mt-4 my-8 sm:mx-4 pl-4">
                <h1 class="text-gray-800 lg:text-4xl md:text-3xl sm:text-3xl text-xl inline-flex items-center gap-2">
                    <%= content_for?(:title_header) ? yield(:title_header) : @collection.title %>
                </h1>
                <h2 class="w-full font-thin text-gray-600 lg:text-2xl md:text-2xl sm:text-2xl text-lg">
                    <%= yield(:description) %>
                </h2>
            </div>

        </div>
    </div>
</section>
<%= yield %>
<% end %>
<%= render template: "layouts/application" %>
