<% content_for :content do %>
<section class="w-full">
    <div class="flex flex-col">
        <!-- Cover Image -->
        <div class="bg-center bg-cover w-full xl:h-[20rem] lg:h-[18rem] md:h-[16rem] sm:h-[14rem] h-[11rem]"
            style="background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.3)), url('<%= @collection&.inherited(:banner_url) || image_path("chalkboard.jpg") %>')">
            <div class="w-full h-full relative text-white drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.95)]">
                <div class="absolute left-0 top-0 w-full overflow-x-auto">
                    <nav aria-label="Breadcrumb" class="px-4 py-3">
                        <%= yield(:breadcrumb) %>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="sm:w-[80%] w-[90%] mx-auto mb-4 flex">
            <%= image_tag @collection&.inherited(:icon_url) || image_path("logo-square.png"), alt: "logo", 
                class: "bg-white rounded-md drop-shadow-lg border-2 border-gray-300 lg:w-[12rem] lg:h-[12rem] md:w-[10rem] md:h-[10rem] sm:w-[8rem] sm:h-[8rem] w-[7rem] h-[7rem] relative lg:bottom-[5rem] lg:mb-[-5rem] sm:bottom-[4rem] sm:mb-[-5rem] bottom-[3rem] mb-[-3rem]" %>

            <div class="w-full text-left my-4 sm:mx-4 pl-4">
                <% if @collection.parent.present? %>
                    <div class="text-sm font-light text-gray-600 mb-1 flex gap-1">
                        <%= render BreadcrumbsComponent.new(
                            { text: @collection.root.title, link: @collection.root },
                            *@collection.root.relative_crumbs(@collection, true)[0...-1]
                            ) %>
                    </div>
                <% end %>
                <h1 class="text-gray-800 lg:text-4xl md:text-3xl sm:text-3xl text-xl inline-flex items-center gap-2 mb-1">
                    <%# if page is not the collection %>
                    <% if @collection.persisted? && current_page?(collection_path(@collection)) %>
                        <span>
                            <%= @collection.title %>
                        </span>
                    <% else %>
                        <%= link_to @collection.title, @collection, class: "hover:underline" %>
                    <% end %>
                    <% if @buttons.present? %>
                        <span class="hidden md:inline">
                            <% @buttons.each do |button| %>
                              <%= render MenuToggleComponent.new(*button) %>
                            <% end %>
                        </span>
                    <% end %>
                </h1>
                <% if content_for?(:description) %>
                    <h2 class="w-full font-thin text-gray-600 text-lg hidden md:block">
                        <%= yield(:description) %>
                    </h2>
                <% end %>
            </div>

        </div>
        <h2 class="md:hidden sm:w-[80%] w-[90%] font-thin text-gray-600 text-lg mx-auto flex gap-2 mb-3">
            <% if content_for?(:description) %>
                <%= yield(:description) %>
            <% end %>
            <% if @buttons.present? %>
                <% @buttons.each do |button| %>
                    <%= render MenuToggleComponent.new(*button) %>
                <% end %>
            <% end %>
        </h2>
    </div>
</section>
<section class="m-auto w-full md:w-3/4 px-3">
    <%= yield %>
    <div class="my-8">
        <% if content_for(:back_to) %>
            <%= yield(:back_to) %>
        <% elsif @collection.new_record? && @collection.parent.present? %>
            <%= link_to "« Back to #{@collection.parent.short_title}", @collection.parent,
                class: "text-sky-600 hover:text-sky-800 hover:underline" %>
        <% elsif @collection.new_record? %>
            <%= link_to "« Back to Collections", collections_path,
                class: "text-sky-600 hover:text-sky-800 hover:underline" %>
        <% elsif !current_page?(collection_path @collection) %>
            <%= link_to "« Back to #{@collection.short_title}", @collection,
                class: "text-sky-600 hover:text-sky-800 hover:underline" %>
        <% elsif @collection.parent.present? %>
            <%= link_to "« Back to #{@collection.parent.short_title}", @collection.parent,
                class: "text-sky-600 hover:text-sky-800 hover:underline" %>
        <% end %>
    </div>
</section>
<% end %>

<%= render template: "layouts/application" %>
