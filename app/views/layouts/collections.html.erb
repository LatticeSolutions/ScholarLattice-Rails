<% content_for :content do %>
<section class="w-full overflow-hidden">
    <div class="flex flex-col">
        <!-- Cover Image -->
        <div class="bg-center bg-cover w-full xl:h-[20rem] lg:h-[18rem] md:h-[16rem] sm:h-[14rem] h-[11rem]"
            style="background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('<%= image_path("college.jpg") %>')">
            <%= yield(:breadcrumb) %>
            <%= yield(:admin) %>
        </div>

        <div class="sm:w-[80%] w-[90%] mx-auto flex">
            <%= image_tag "logo.svg", alt: "logo", 
                class: "bg-white rounded-md lg:w-[12rem] lg:h-[12rem] md:w-[10rem] md:h-[10rem] sm:w-[8rem] sm:h-[8rem] w-[7rem] h-[7rem] outline outline-2 outline-offset-2 outline-gray-500 relative lg:bottom-[5rem] sm:bottom-[4rem] bottom-[3rem]" %>

            <div class="w-full text-left my-4 sm:mx-4 pl-4">
                <h1 class="text-gray-800 lg:text-4xl md:text-3xl sm:text-3xl text-xl">
                    <%= @collection.title %>
                </h1>
                <h2 class="font-thin text-gray-600 lg:text-2xl md:text-2xl sm:text-2xl text-lg">
                    <%= @collection.description %>
                </h2>
            </div>

        </div>
    </div>
</section>
<%= yield %>
<% end %>
<%= render template: "layouts/application" %>
