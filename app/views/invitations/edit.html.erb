<% content_for :title, "Edit Invitation | #{@invitation.collection.title}" %>
<% content_for :breadcrumb do %>
    <%= render partial: "breadcrumb", locals: { collection: @collection, action: "Edit" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:invitation) %>
    </span>
    <span>
      Edit Invitation
    </span>
  </div>
<% end %>

  <%= render "form", invitation: @invitation %>
