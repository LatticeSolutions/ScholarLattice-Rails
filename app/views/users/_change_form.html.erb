<div class="mx-auto bg-white w-5/6 my-2 p-4 rounded-lg border">
    <%= form_with model: user, url: url, method: method, data: { turbo: false } do |form| %>
        <%= form.label :email, class: CssClass::LABEL do %>
            Change user/email
            <span class="size-4 inline-block">
                <%= render IconComponent.new(:key) %>
            </span>
        <% end %>
        <%= form.email_field :email, class: CssClass::EMAIL_FIELD %>
        <span class="<%= CssClass::BUTTON_BAR %> mt-2">
            <%= form.submit "Update", class: CssClass::SUBMIT %>
        </span>
    <% end %>
</div>
