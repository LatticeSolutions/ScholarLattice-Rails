<% content_for :title, "Submission ‟#{@submission.title}” | #{@submission.collection.title}" %>
<% content_for :breadcrumb do %>
    <%= render partial: "breadcrumb", locals: { collection: @submission.collection, action: "Details" } %>
<% end %>
<% content_for :description do %>
  <div>
    <div class="flex items-center">
      <span class="size-8 inline-block mr-1">
        <%= render IconComponent.new(:submission) %>
      </span>
      <span>
        ‟<%= @submission.title %>” by 
        <% if @submission.author_list.present? %>
          <%= @submission.author_list %>
        <% else %>
          <%= @submission.user.name_with_email %>, <%= @submission.user.affiliation %> 
        <% end %>
        <% unless @submission.accepted? %>
          (<%= @submission.status.humanize %>)
        <% end %>
        <% if can? :edit, @submission %>
          <%= link_to "[Edit]", edit_submission_path(@submission), class: "text-blue-500 hover:underline" %>
        <% end %>
      </span>
    </div>
  </div>
<% end %>
<% if can? :manage, @collection %>
  <% content_for :title_buttons do %>
    <%= render MenuToggleComponent.new(
        "Admin",
        :key,
        true,
        {path: edit_submission_path(@submission), text: "Edit"},
        { 
            path: @submission, 
            text: "Delete submission",
            method: :delete,
            confirm: "Are you sure you want to delete this submission?",
            hidden: (cannot? :destroy, @submission),
            styles: "text-red-800"
        },
    ) %>
  <% end %>
<% end %>

    <%= render @submission %>

    <% if can? :manage, @collection %>
      <p class="my-5">
        <strong class="block font-medium mb-1">
          Registrations: <span class="inline-block size-4">
            <%= render IconComponent.new(:key) %>
          </span>
        </strong>  
        <% if @registrations&.any? %>
          <ul class="list-disc list-inside my-5">
            <% @registrations.each do |registration| %>
              <li>
                <%= link_to registration.user, class: "text-blue-600 hover:underline" do %>
                  <%= registration.collection.short_title_path %> |
                  <%= registration.registration_option_choices.map(&:registration_option).map(&:name).join(', ') %> |
                  <%= registration.status.humanize %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          This user has not registered.
        <% end %>
      </p>
    <% end %>

    <% if @submission.event.present? %>
      <p class="my-5">
        <strong class="block font-medium mb-1">Scheduled for:</strong>     
        <% if @submission.event.starts_at %>
          <%= @submission.event.starts_at
            .in_time_zone(@submission.collection.inherited_time_zone)
            .strftime("%Y-%m-%d %I:%M %p") %>:
        <% end %>
        <%= link_to @submission.event.title, @submission.event, class: "text-blue-600 hover:underline" %>
        <% if @submission.event.inherited(:location).present? %>
            <span class="text-sm">in <span class="text-green-800"><%= @submission.event.inherited(:location) %></span></span>
        <% end %>
      </p>
      <% if @submission.event.inherited(:webinar_link).present? %>
        <p class="my-5">
          <%= link_to event_webinar_path(@submission.event), target: "_blank", class: "inline-flex items-center gap-2 rounded-md bg-purple-600 px-2 py-1 text-base text-white shadow-sm hover:bg-purple-700 focus:outline-none focus:ring focus:ring-purple-400 break-all" do %>
            <span class="inline-block size-3">
                <%= render IconComponent.new(:video) %>
            </span>
            Webinar
          <% end %>
        </p>
      <% end %>
    <% end %>

