<% content_for :title, "Upload Submissions | #{@collection.title}" %>
<% content_for :breadcrumb do %>
    <%= render partial: "breadcrumb", locals: { collection: @collection, action: "Upload" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:submission) %>
    </span>
    <span>
      Upload Submissions
    </span>
  </div>
<% end %>


  <p class="mt-4 text-sm">
    The top row of your CSV should be a header row describing its contents.
  </p>

  <%= form_with url: collection_submissions_import_path(@collection), data: { turbo: false }, local: true, html: { multipart: true, class: "mt-4" } do |form| %>
    <div class="mb-4">
      <%= form.label :file, "Choose CSV file", class: CssClass::LABEL %>
      <%= form.file_field :file, class: CssClass::FILE_UPLOAD, accept: ".csv" %>
    </div>
    <div>
      <%= form.submit "Upload", class: "rounded-lg py-3 px-5 bg-blue-500 text-white font-medium" %>
      <%= link_to "Back to submissions", collection_submissions_path(@collection), class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    </div>
  <% end %>
