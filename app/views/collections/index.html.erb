<% content_for :title, "Collections" %>

<section class="p-8 w-full">
    <h1 class="text-2xl font-bold text-gray-900 md:text-3xl mb-5 flex items-center">
        <span class="size-10">
            <%= render IconComponent.new(:collection) %>
        </span>
        <span class="px-3">Collections</span>
        <% if can? :create, Collection.new %>
                <%= link_to new_collection_path, class: CssClass::LINK do %>
                    <span class="text-base font-normal">New</span>
                <% end %>
        <% end %>
    </h1>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
        <% @collections.each do |collection| %>
            <%= render partial: "card", locals: { collection: collection, user: @current_user } %>
        <% end %>
    </div>

</section>
