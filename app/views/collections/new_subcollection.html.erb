<% content_for :title, "New Subcollection" %>
<% content_for :description do %>
    <span>
        New Subcollection
    </span>
<% end %>
<% content_for :breadcrumb do %>
    <%= render "breadcrumb", collection: @collection, action: "New #{@collection.subcollection_name}" %>
<% end %>

<%= render "form", collection: @subcollection, cancel_path: collections_path %>
