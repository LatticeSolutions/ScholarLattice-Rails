<% content_for :title, @collection.title %>
<% content_for :description, @collection.description %>
<% @buttons = [
    [
        "Connect",
        :profile,
        true,
        {
            icon: :star,
            path: like_collection_path(@collection),
            text: "Mark as Favorite",
            method: :post,
            hidden: @collection.favorite_users.include?(@current_user),
            styles: "text-gray-500"
        },
        {
            icon: :star,
            path: dislike_collection_path(@collection),
            text: "Favorited!",
            method: :post,
            hidden: !@collection.favorite_users.include?(@current_user),
            styles: "text-yellow-600"
        },
        {
            icon: :registration,
            path: new_collection_registration_path(@collection),
            text: "Register",
            hidden: !@collection.registrations_open? || @current_user&.registered_collections&.include?(@collection),
            styles: "text-gray-600"
        },
        {
            icon: :registration,
            path: collection_registrations_mine_path(@collection),
            text: "View registration",
            hidden: @current_user.nil? || @current_user.registered_collections.exclude?(@collection),
            styles: "text-green-600"
        },
        {
            icon: :registration,
            path: nil,
            text: "No registrations remaining",
            hidden: @current_user&.registered_collections&.include?(@collection) || @collection.registrations_in_stock?,
            styles: "text-gray-400 cursor-not-allowed",
            disabled: true
        },
        {
            icon: :submission,
            path: new_collection_submission_path(@collection),
            text: "Submit abstract",
            hidden: !@collection.submittable
        },
    ]] %>
<% if @collection.children.any? %>
    <% @buttons << [
        "Subcollections",
        :collection_outline,
        true,
        *@collection.children.map{|c| {text: c.short_title, path: collection_path(c)}},
    ] %>
<% end %>
<% @buttons << [
    "Pages",
    :page,
    true,
    {
        icon: :calendar,
        path: collection_events_path(@collection),
        text: "Events",
        hidden: !@collection.show_events
    },
    {
        icon: :location,
        path: collection_locations_path(@collection),
        text: "Locations",
        hidden: @collection.locations.none?
    },
    *@collection.pages.map { |p| { icon: :page, text: p.title, path: page_path(p) } }
] %>
<% if can? :manage, @collection %>
    <% @buttons = [
        [
            "Admin",
            :key,
            true,
            {icon: :edit, path: edit_collection_path, text: "Edit"},
            {icon: :collection_outline, path: new_subcollection_path, text: "New #{@collection.subcollection_name}"},
            {icon: :page, path: new_collection_page_path(@collection), text: "New Page"},
            {icon: :calendar, path: collection_events_path(@collection), text: "Events (#{@collection.all_events.count})"},
            {
                icon: :profile, 
                path: collection_people_path(@collection), 
                text: "People (#{@collection.connected_users.length})"
            },
            {
                path: collection_compose_message_path(@collection), 
                text: "Send message"
            },
            {
                icon: :invitation, 
                path: collection_invitations_path(@collection), 
                text: "Invitations (#{@collection.subtree_invitations.count})"
            },
            {
                icon: :submission, 
                path: collection_submissions_path(@collection), 
                text: "Submissions (#{@collection.subtree_submissions.count})"
            },
            {
                icon: :registration, 
                path: collection_registrations_path(@collection), 
                text: "Registrations (#{@collection.registrations.count})"
            },
            {
                icon: :location, 
                path: collection_locations_path(@collection), 
                text: "Locations (#{@collection.locations.count})"
            },
            { 
                path: @collection, 
                text: "Delete collection",
                method: :delete,
                confirm: "Are you sure you want to delete this collection?",
                hidden: (cannot? :destroy, @collection),
                styles: "text-red-800"
            },
        ]] + @buttons
    %>
<% end %>
<% content_for :breadcrumb do %>
    <%= render partial: "breadcrumb", locals: { collection: @collection } %>
<% end %>

<div class="my-2 flex gap-3 justify-center">
    <% if @collection.registrations_open? and (@current_user.blank? or @current_user.registered_collections.exclude?(@collection)) %>
        <%= link_to new_collection_registration_path(@collection), 
            class: "inline-flex items-center gap-2 rounded-md cursor-pointer ml-1 px-4 py-2 my-1 md:text-lg hover:ring-2 ring-green-200 text-green-700 drop-shadow-md bg-green-50 hover:bg-green-100" do %>
            <span class="size-4">
                <%= render IconComponent.new(:registration) %>
            </span>
            <span>Register</span>
        <% end %>
    <% end %>
    <% if @current_user.present? and @current_user.registered_collections.include?(@collection) %>
        <%= link_to collection_registrations_mine_path(@collection), 
            class: "inline-flex items-center gap-2 rounded-md cursor-pointer ml-1 px-4 py-2 my-1 md:text-lg hover:ring-2 ring-green-200 bg-green-100 text-green-700 drop-shadow-md hover:bg-green-200" do %>
            <span class="size-4">
                <%= render IconComponent.new(:registration) %>
            </span>
            <span>View your registration</span>
        <% end %>
    <% end %>
    <% if @collection.submissions_open? %>
        <%= link_to new_collection_submission_path(@collection), 
            class: "inline-flex items-center gap-2 rounded-md cursor-pointer ml-1 px-4 py-2 my-1 md:text-lg hover:ring-2 ring-sky-200 text-sky-700 drop-shadow-md bg-sky-50 hover:bg-sky-100" do %>
            <span class="size-4">
                <%= render IconComponent.new(:submission) %>
            </span>
            <span>Submit abstract</span>
        <% end %>
    <% end %>
    <% if @collection.subtree_submissions.where(status: :accepted).any? %>
        <%= link_to collection_submissions_path(@collection), 
            class: "inline-flex items-center gap-2 rounded-md cursor-pointer ml-1 px-4 py-2 my-1 md:text-lg hover:ring-2 ring-cyan-200 text-cyan-700 drop-shadow-md bg-cyan-50 hover:bg-cyan-100" do %>
            <span class="size-4">
                <%= render IconComponent.new(:submission) %>
            </span>
            <span>Accepted submissions</span>
        <% end %>
    <% end %>
</div>

<% if @collection.content.present? %>
    <div class="mathjax prose !max-w-none sm:prose-lg mx-auto prose-a:text-blue-600 hover:prose-a:text-blue-500 prose-a:no-underline">
        <%= sanitize @collection.to_html(:content) %>
    </div>
<% end %>

<% if @current_user.present? and @current_user.submissions.where(collection: @collection).any? %>
    <div>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl my-4">
            Your submissions:
        </h2>
        <ul class="list-disc list-inside">
            <% @current_user.submissions.where(collection: @collection).each do |s| %>
                <li>
                    <%= link_to "#{s.title} (#{s.status.humanize})", s, class: "text-blue-600 hover:underline" %>
                </li>
            <% end %>
        </ul>
    </div>
<% end %>

<% if @collection.all_top_scheduled_events.any? and @collection.show_events %>
    <div class="my-8 w-full lg:w-5/6 mx-auto rounded-md border border-gray-300 p-4">
        <h2 class="text-lg md:text-xl font-medium pb-1 border-b border-gray-200">
            Schedule at a Glance
            <%= link_to "[Full Schedule]", collection_events_path(@collection), class: "font-normal text-base md:text-lg text-blue-500 hover:underline" %>
        </h2>
        <%= render partial: "events/by_day", locals: { collection: @collection, events: @collection.all_top_scheduled_events, depth: 0 } %>
    </div>
<% end %>

<% unless @collection.children.empty? %>
    <h2 class="text-xl font-medium text-gray-800 md:text-2xl my-4">
        <%= @collection.subcollection_name.pluralize %>:
    </h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
        <% @collection.children.each do |collection| %>
            <%= render partial: "card", locals: { collection: collection, user: @current_user } %>
        <% end %>
    </div>
<% end %>
