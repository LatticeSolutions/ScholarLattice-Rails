<% content_for :title, @collection.title %>
<% content_for :title_header do %>
    <span>
        <%= @collection.title %>
    </span>
    <%= render MenuToggleComponent.new(
        "Connect",
        :profile,
        true,
        {icon: :star, path: like_collection_path(@collection), text: "Add Favorite", method: :post},
        {icon: :star, path: dislike_collection_path(@collection), text: "Favorited!", method: :post},
        {icon: :registration, path: collection_registrations_mine_path(@collection), text: "Registered!"},
        {icon: :registration, path: new_collection_registration_path(@collection), text: "Register here"},
        {icon: :registration, path: nil, text: "No registrations remaining"},
        {icon: :submission, path: collection_events_path(@collection), text: "Submit here"},
        {icon: :calendar, path: collection_events_path(@collection), text: "Events"},
        ) %>

    <% unless @collection.children.empty? %>
        <%= render MenuToggleComponent.new(
            "Subcollections",
            :collection_outline,
            true,
            *@collection.children.map{|c| {text: c.short_title, path: collection_path(c)}},
            ) %>
    <% end %>
    <% unless @collection.public_pages.empty? %>
        <%= render PagesBarComponent.new(@collection.public_pages) %>
    <% end %>
<% end %>
<% content_for :breadcrumb do %>
    <%= render partial: "breadcrumb", locals: { collection: @collection } %>
<% end %>
<% content_for :admin do %>
    <% if can? :manage, @collection %>
        <%= render MenuToggleComponent.new(
            "Admin",
            :key,
            false,
            {icon: :edit, path: edit_collection_path, text: "Edit"},
            {icon: :edit, path: @collection.home_page ? edit_page_path(@collection.home_page) : "/", text: "Edit Home Page", hidden: @collection.home_page.blank?},
            {icon: :collection_outline, path: new_subcollection_path, text: "New #{@collection.subcollection_name}"},
            {icon: :page, path: new_collection_page_path(@collection), text: "New Page"},
            {icon: :calendar, path: collection_events_path(@collection), text: "Events (#{@collection.all_events.count})"},
            {
                icon: :profile, 
                path: collection_people_path(@collection), 
                text: "People (#{@collection.connected_users.length})"
            },
            {
                icon: :invitation, 
                path: collection_invitations_path(@collection), 
                text: "Invitations (#{@collection.subtree_invitations.count})"
            },
            {
                icon: :submission, 
                path: collection_submissions_path(@collection), 
                text: "Submissions (#{@collection.subtree_submissions.count})"
            },
            {
                icon: :registration, 
                path: collection_registrations_path(@collection), 
                text: "Registrations (#{@collection.registrations.count})"
            },
        ) %>
    <% end %>
<% end %>

<section class="mx-4 w-full md:mx-auto md:w-3/4">

    <% if @collection.attached_event.present? %>
        <h2 class="text-1.5xl font-light text-gray-900 md:text-2xl pb-5">
            <%= @collection.attached_event.times_in_time_zone %> (<%= @collection.attached_event.collection.inherited_time_zone %>)
            <% if @collection.attached_event.inherited(:location).present? %>
              in <%= @collection.attached_event.inherited(:location) %>
            <% end %>
            <% if @collection.attached_event.webinar_link.present? %>
                <%= link_to event_webinar_path(@collection.attached_event), target: "_blank", class: "inline-flex items-center gap-2 rounded-md bg-purple-600 px-2 py-1 text-base text-white shadow-sm hover:bg-purple-700 focus:outline-none focus:ring focus:ring-purple-400 break-all" do %>
                    <span class="inline-block size-3">
                        <%= render IconComponent.new(:video) %>
                    </span>
                    Webinar
                <% end %>
            <% end %>
            <% if can? :manage, @collection.attached_event %>
                <%= link_to "Edit event", edit_event_path(@collection.attached_event), class: "inline-flex items-center gap-2 rounded-md bg-white px-2 py-1 text-base text-green-600 shadow-sm hover:bg-green-50 focus:outline-none focus:ring focus:ring-green-400 break-all" %>
            <% end %>
        </h2>
    <% end %>

    <% unless @collection.non_public_pages.empty? %>
        <% if can? :manage, @collection %>
            <div class="pt-4">
                <%= render PagesBarComponent.new(@collection.non_public_pages, public: false, label: "Non-public Pages") %>
            </div>
        <% end %>
    <% end %>

    <% if @collection.home_page.present? %>
        <div class="mathjax pt-4 prose !max-w-none sm:prose-lg mx-auto prose-a:text-blue-600 hover:prose-a:text-blue-500 prose-a:no-underline">
            <%= sanitize @collection.home_page.content_html %>
        </div>
    <% end %>

    <% unless @current_user.nil? or @current_user.submissions.where(collection: @collection).empty? %>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl py-3 mt-4">
            Your Submissions:
        </h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
            <% @current_user.submissions.where(collection: @collection).each do |submission| %>
                <%= render partial: "submissions/card", locals: { submission: submission } %>
            <% end %>
        </div>
    <% end %>

    <% unless @collection.submissions.accepted.empty? %>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl py-3 mt-4">
            Accepted Submissions:
        </h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
            <% @collection.submissions.accepted.each do |submission| %>
                <%= render partial: "submissions/card", locals: { submission: submission } %>
            <% end %>
        </div>
    <% end %>

    <% unless @collection.children.empty? %>
        <h2 class="text-xl font-medium text-gray-800 md:text-2xl py-3">
            <%= @collection.subcollection_name.pluralize %>:
        </h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
            <% @collection.children.each do |collection| %>
                <%= render partial: "card", locals: { collection: collection, user: @current_user } %>
            <% end %>
        </div>
    <% end %>

    <p class="mt-3">
        <% unless @collection.parent.nil? %>
            <%= link_to "« Back to #{@collection.parent.short_title}", @collection.parent,
                class: "text-sky-600 hover:text-sky-800 hover:underline" %>
        <% end %>
    </p>

    <% if can? :destroy, @collection %>
        <%= button_to "Delete this collection", @collection, "@click" => "if(!confirm('Are you sure?')) $event.preventDefault()",
            class: "ml-2 mt-2 rounded-lg py-3 px-5 bg-red-100 text-red-800 inline-block font-medium", form_class: "mt-3", method: :delete %>
    <% end %>
</section>
