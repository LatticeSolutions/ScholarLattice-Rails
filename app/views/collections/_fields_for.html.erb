<%= form.hidden_field :parent_id %>

<div class="mb-3">
  <%= form.label :title, class: CssClass::LABEL %>
  <%= form.text_field :title, class: CssClass::TEXT_FIELD %>
  <%= render "errors", object: collection, attribute: :title %>
</div>

<div class="mb-3">
  <%= form.label :short_title, class: CssClass::LABEL do %>
    Short title
    <span class="<%= CssClass::SUBLABEL %>">
      for use in navigation
    </span>
  <% end %>
  <%= form.text_field :short_title, class: CssClass::TEXT_FIELD_INLINE %>
  <%= render "errors", object: collection, attribute: :short_title %>
</div>

<div class="mb-3">
  <%= form.label :description, class: CssClass::LABEL do %>
    Description
    <span class="<%= CssClass::SUBLABEL %>">
      One line summarizing the purpose of this collection
    </span>
  <% end %>
  <%= form.text_field :description, class: CssClass::TEXT_FIELD %>
  <%= render "errors", object: collection, attribute: :description %>
</div>

<% if collection.parent_id.present? and !collection.new_record? %>
<div class="mb-3">
  <%= form.label "Subcollection of", class: CssClass::LABEL %>
  <%= form.select :parent_id, 
        Collection.sort_by_ancestry(@current_user.admin_collections).reject{|c| collection.subtree.include? c}.map {|c| [c.short_title_path, c.id]},
        {selected: collection.parent_id},
        {class: CssClass::SELECT_INLINE} %>
  <%= render "errors", object: collection, attribute: :parent_id %>
</div>
<% end %>

<div class="mb-3">
  <%= form.label :order, class: CssClass::LABEL do %>
    Order <span class="<%= CssClass::SUBLABEL %>">of appearance</span>
  <% end %>
  <%= form.number_field :order, class: CssClass::NUMBER_FIELD_INLINE %>
  <%= render "errors", object: collection, attribute: :order %>
</div>

<div class="mb-3">
  <%= form.label :subcollection_name, class: CssClass::LABEL %>
  <%= form.text_field :subcollection_name, class: CssClass::TEXT_FIELD_INLINE %>
  <%= render "errors", object: collection, attribute: :subcollection_name %>
</div>

<div class="mb-3">
  <%= form.label :time_zone, class: CssClass::LABEL %>
  <%= form.select :time_zone, [["Use default time zone (#{collection.parent_time_zone})", nil]] + 
    ActiveSupport::TimeZone.all.map { |tz| ["#{tz.name} (UTC #{tz.formatted_offset})", tz.name] }, 
    {}, class: CssClass::SELECT_INLINE %>
  <%= render "errors", object: collection, attribute: :time_zone %>
</div>

<div class="mb-3">
  <%= form.label :admin_emails, class: CssClass::LABEL do %>
    Admin emails
    <span class="<%= CssClass::SUBLABEL %>">(comma-separated, must be registered)</span>
  <% end %>

  <%= form.text_field :admin_emails, class: CssClass::TEXT_FIELD %>
  <%= render "errors", object: collection, attribute: :admin_emails %>
</div>


<h3 class="text-xl font-medium text-gray-900 mt-10 mb-3">Submission Settings</h3>

<div class="mb-3">
  <%= form.label :submittable, class: CssClass::LABEL %>
  <%= form.check_box :submittable, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: collection, attribute: :submittable %>
</div>

<div class="mb-3">
  <%= form.label :submissions_open_on, class: CssClass::LABEL %>
  <% Time.use_zone(collection.inherited_time_zone) do %>
    <%= form.datetime_field :submissions_open_on, class: CssClass::DATETIME_FIELD_INLINE %>
  <% end %>

  <%= render "errors", object: collection, attribute: :submissions_open_on %>
</div>

<div class="mb-3">
  <%= form.label :submissions_close_on, class: CssClass::LABEL %>
  <% Time.use_zone(collection.inherited_time_zone) do %>
    <%= form.datetime_field :submissions_close_on, class: CssClass::DATETIME_FIELD_INLINE %>
  <% end %>

  <%= render "errors", object: collection, attribute: :submissions_close_on %>
</div>


<h3 class="text-xl font-medium text-gray-900 mt-10 mb-3">Event Settings</h3>

<div class="mb-3">
  <%= form.label :show_events, class: CssClass::LABEL do %>Show Events button<% end %>
  <%= form.check_box :show_events, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: collection, attribute: :show_events %>
</div>

<div class="mb-3">
  <%= form.label :public_webinars, class: CssClass::LABEL %>
  <%= form.check_box :public_webinars, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: collection, attribute: :public_webinars %>
</div>


<h3 class="text-xl font-medium text-gray-900 mt-10 mb-3">Registration Settings</h3>

<div class="mb-3">
  <%= form.label :registerable, class: CssClass::LABEL %>
  <%= form.check_box :registerable, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: collection, attribute: :registerable %>
</div>

<div class="mb-3">
  <%= form.label :limit_one_registration_option, class: CssClass::LABEL %>
  <%= form.check_box :limit_one_registration_option, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: collection, attribute: :limit_one_registration_option %>
</div>

<div class="mb-3">
  <%= form.label :paypal_link, class: CssClass::LABEL do %>
    PayPal Link for Payments
    <span class="<%= CssClass::SUBLABEL %>">(must be a URL starting with <code>https://www.paypal.com/ncp/payment</code>)</span>
  <% end %>
  <%= form.url_field :paypal_link, class: CssClass::URL_FIELD %>
  <%= render "errors", object: collection, attribute: :paypal_link %>
</div>
