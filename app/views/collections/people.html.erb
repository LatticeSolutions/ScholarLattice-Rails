<% content_for :title, "People | #{@collection.title}" %>

<section class="mx-auto md:w-3/4 w-full">
    <%= render partial: "breadcrumb", locals: { collection: @collection, action: "People", icon: :profile } %>

    <h1 class="text-2xl font-bold text-gray-900 md:text-3xl py-5">
        All admins of <%= @collection.title %> and its subcollections
        (<%= @collection.sub_admins.count %>)
    </h1>

    <div class="text-gray-700 py-3">
        <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
            @collection.sub_admin_emails
        %></textarea>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 md:text-3xl py-5">
        All emails connected to <%= @collection.title %>
        (<%= @collection.connected_users.length %>)
    </h1>

    <div class="text-gray-700 py-3">
        <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
            @collection.connected_users.map(&:email).uniq.join("; ")
        %></textarea>
    </div>
    
    <h1 class="text-2xl font-bold text-gray-900 md:text-3xl py-5">
        Connected emails who have not submitted
        (<%= @collection.connected_unsubmitted_users.length %>)
    </h1>

    <div class="text-gray-700 py-3">
        <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
            @collection.connected_unsubmitted_users.map(&:email).uniq.join("; ")
        %></textarea>
    </div>
    
    <h1 class="text-2xl font-bold text-gray-900 md:text-3xl py-5">
        Connected emails who have not registered
        (<%= @collection.connected_unregistered_users.length %>)
    </h1>

    <div class="text-gray-700 py-3">
        <textarea class="w-full h-12 bg-gray-100 p-2" readonly><%= 
            @collection.connected_unregistered_users.map(&:email).uniq.join("; ")
        %></textarea>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 md:text-3xl py-5">
        Table of connected users
    </h1>
    <table>
        <thead>
            <tr>
                <th class="text-left px-2">Name</th>
                <th class="text-left px-2">Affiliation</th>
                <th class="text-left px-2">Email</th>
                <th class="text-left px-2">Invitations</th>
                <th class="text-left px-2">Submissions</th>
                <th class="text-left px-2">Registrations</th>
            </tr>
        </thead>
        <tbody>
            <% @collection.connected_users.each do |user| %>
                <tr class="hover:bg-gray-100">
                    <td class="p-2"><%= user.name %></td>
                    <td class="p-2"><%= user.affiliation %></td>
                    <td class="p-2"><%= user.email %></td>
                    <td class="p-2">
                        <% user.invitations.where(collection: @collection.subtree).each do |i| %>
                            <%= link_to i, class: "text-blue-600 hover:underline block" do %>
                                <%= i.status %>
                            <% end %>
                        <% end %>
                    </td>
                    <td class="p-2">
                        <% user.submissions.where(collection: @collection.subtree).each do |s| %>
                            <%= link_to s, class: "text-blue-600 hover:underline block" do %>
                                <%= s.title %> (<%= s.status %>)
                            <% end %>
                        <% end %>
                    </td>
                    <td class="p-2">
                        <% user.registrations.where(collection: @collection.path).each do |r| %>
                            <%= link_to r, class: "text-blue-600 hover:underline block" do %>
                                <%= r.collection.short_title %> (<%= r.status %>)
                            <% end %>
                        <% end %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
</section>
