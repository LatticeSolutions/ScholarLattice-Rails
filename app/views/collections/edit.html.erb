<% content_for :title, "Edit Collection" %>
<% content_for :title_header do %>
    <span>
        Edit <%= link_to @collection.short_title, @collection, class: CssClass::LINK %>
    </span>
<% end %>
<% content_for :breadcrumb do %>
    <%= render "breadcrumb", collection: @collection, action: "Edit" %>
<% end %>

<section class="mx-4 w-full md:mx-auto md:w-3/4">
    <%= render "form", collection: @collection, cancel_path: collection_path %>
</section>
