<div class="my-5">
  <%= form.label :name, class: CssClass::LABEL %>
  <%= form.text_field :name, value: option.name,
      class: CssClass::TEXT_FIELD %>
  <%= render "errors", object: option, attribute: :name %>
</div>

<div class="my-5">
  <%= form.label :cost, class: CssClass::LABEL do %>
    Cost in USD cents
    <span class="<%= CssClass::SUBLABEL %>">Leave blank for no-cost registrations</span>
  <% end %>
  <%= form.number_field :cost, value: option.cost,
      class: CssClass::NUMBER_FIELD %>   
  <%= render "errors", object: option, attribute: :cost %>
</div>

<div class="my-5">
  <%= form.label :stock, class: CssClass::LABEL %>
  <%= form.number_field :stock, value: option.stock,
      class: CssClass::NUMBER_FIELD %>   
  <%= render "errors", object: option, attribute: :stock %>
</div>

<div class="my-5">
  <%= form.label :allowed_domains, class: CssClass::LABEL do %>
    Comma-separated list of allowed domains
    <span class="<%= CssClass::SUBLABEL %>">Leave blank to not restrict domains</span>
  <% end %>
  <%= form.text_field :allowed_domains, value: option.allowed_domains,
      class: CssClass::TEXT_FIELD %>
  <%= render "errors", object: option, attribute: :allowed_domains %>
</div>

<div class="my-5">
  <%= form.label :info_prompt, class: CssClass::LABEL do %>
    Prompt for further information
  <% end %>
  <%= form.text_field :info_prompt, value: option.info_prompt,
      class: CssClass::TEXT_FIELD %>
  <%= render "errors", object: option, attribute: :info_prompt %>
</div>

<div class="my-5">
  <%= form.label :auto_accept, class: CssClass::LABEL %>
  <%= form.check_box :auto_accept, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: option, attribute: :auto_accept %>
</div>

<div class="my-5">
  <%= form.label :limit_one_per_registration, class: CssClass::LABEL %>
  <%= form.check_box :limit_one_per_registration, class: CssClass::CHECK_BOX %>
  <%= render "errors", object: option, attribute: :limit_one_per_registration %>
</div>

<div class="my-5">
  <%= form.label :opens_on, class: CssClass::LABEL do %>
    Opens on <span class="<%= CssClass::SUBLABEL %>">(<%= collection.inherited_time_zone %>)</span>
  <% end %>
  <% Time.use_zone(collection.inherited_time_zone) do %>
    <%= form.datetime_field :opens_on, class: CssClass::DATETIME_FIELD %> 
  <% end %>
  <%= render "errors", object: option, attribute: :opens_on %>
</div>
<div class="my-5">
  <%= form.label :closes_on, class: CssClass::LABEL do %>
    Closes on <span class="<%= CssClass::SUBLABEL %>">(<%= collection.inherited_time_zone %>)</span>
  <% end %>
  <% Time.use_zone(collection.inherited_time_zone) do %>
    <%= form.datetime_field :closes_on, class: CssClass::DATETIME_FIELD %> 
  <% end %>
  <%= render "errors", object: option, attribute: :closes_on %>
</div>
