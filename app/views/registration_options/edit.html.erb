<% content_for :title, "Edit Registration Option | #{@registration_option.collection.title}" %>
<% content_for :breadcrumb do %>
    <%= render partial: "registrations/breadcrumb", locals: { collection: @collection, action: "Edit Option" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:registration) %>
    </span>
    <span>
      Edit Registration Option
    </span>
  </div>
<% end %>

  <%= render "form", option: @registration_option, collection: @registration_option.collection %>
