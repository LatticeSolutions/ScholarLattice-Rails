<ul class="list-disc pl-5 mt-2">
    <% events.select{|e| e.starts_at.present? }.sort_by { |e| e.starts_at }.each do |event| %>
        <%= render partial: "events/events_list_item", locals: { 
            event: event,
            depth: depth.nil? ? nil : depth
        } %>
    <% end %>
    <% events.select{|e| e.starts_at.blank? }.each do |event| %>
        <%= render partial: "events/events_list_item", locals: { 
            event: event,
            depth: depth.nil? ? nil : depth
        } %>
    <% end %>
</ul>
