<% content_for :title, "Events | #{@collection.title}" %>
<% content_for :breadcrumb do %>
  <%= render partial: "breadcrumb", locals: { collection: @collection } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center">
    <span class="size-8 inline-block mr-1">
      <%= render IconComponent.new(:calendar) %>
    </span>
    <span class="font-normal">Schedule of Events</span>
  </div>
<% end %>

<div class="mt-2 flex justify-between items-center">
  <p>
    All times <%= Time.zone.name %>.
    Page loaded at <%= Time.current.strftime("%I:%M %p") %> <%= Time.zone.name %> (UTC <%= Time.current.in_time_zone(Time.zone.name).formatted_offset %>).
  </p>
  <%= tag.div class: CssClass::BUTTON_BAR do %>
      <%= link_to "Printable page", collection_print_events_path(@collection, depth: 2), class: CssClass::LINK_BUTTON %>
      <% if can? :create, Event %>
        <%= link_to "New event", new_collection_event_path(@collection), class: CssClass::LINK_BUTTON %>
      <% end %>
  <% end %>
</div>

<% if @collection.parent.present? and @collection.parent.show_events? %>
  <div class="mt-4">
    <%= link_to "View all events for #{@collection.parent.title}", collection_events_path(@collection.parent), class: "text-blue-600 hover:underline" %>
  </div>
<% end %>

<% if @collection.all_happening_soon_events.any? %>
  <h2 class="font-bold text-xl md:text-3xl my-3">
    Happening Soon!
  </h2>
  <ul class="list-disc pl-5">
    <% @collection.all_happening_soon_events.each do |event| %>
      <li class="mb-2">
        <%= event.starts_at.strftime("%I:%M %p") %>:
        <%= link_to event.title, event, class: "text-blue-600 hover:underline" %>
        <% if event.inherited(:location).present? %>
          <span class="text-sm">in <span class="text-green-800"><%= event.inherited(:location) %></span></span>
        <% end %>
        <% if event.inherited(:webinar_link).present? && can?(:access_webinars, event.collection) %>
            <%= link_to event_webinar_path(event), 
                class: "inline-block bg-purple-600 hover:bg-purple-700 text-white font-semibold px-1 py-1 rounded transition-colors duration-150 ml-2", 
                target: "_blank", 
                rel: "noopener" do %>
                <span class="inline-block size-4">
                    <%= render IconComponent.new(:video) %>
                </span>
            <% end %>
        <% end %>
        <% if event.submission.present? %>
          <br>
          <span class="italic mathjax"><%= event.submission.title %></span>
          &mdash;
          <%= event.submission.user.name %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<div class="my-4">
<%= render partial: "events/search_form", locals: {collection: @collection, query: ""} %>
</div>

<% if @collection.all_top_scheduled_events.any? %>
  <%= render partial: "events/by_day", locals: {collection: @collection, events: @collection.all_top_scheduled_events, depth: nil} %>
<% end %>

<% if @collection.all_top_unscheduled_events.any? %>
  <h3 class="font-bold text-xl mt-4">Unscheduled Events</h3>
  <ul class="list-disc pl-5">
    <% @collection.all_top_unscheduled_events.each do |event| %>
      <li class="my-1"><%= link_to event.title, event, class: "text-blue-700 hover:underline" %></li>
    <% end %>
  </ul>
<% end %>
