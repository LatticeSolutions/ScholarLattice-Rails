<% content_for :title, "Create subevents for #{@event.title} | #{@event.collection.title}" %>
<% content_for :breadcrumb do %>
  <%= render partial: "breadcrumb", locals: { collection: @event.collection, action: "Subevents" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center gap-2">
    <span class="size-8 inline-block mr-1">
      <%= link_to collection_events_path(@event.collection) do %>
          <%= render IconComponent.new(:calendar) %>
      <% end %>
    </span>
    <span class="font-normal">Generate Subevents</span>
  </div>
<% end %>

<div x-data="{ sameTimes: false }">
    <p class="mb-4">
      Create subevents for
      <span class="font-medium"><%= @event.title %></span> starting at
      <%= @event.starts_at&.strftime("%Y-%m-%d %I:%M %p") || "(unscheduled)" %>
      <% if @event.ends_at.present? %>
        and ending at <%= @event.ends_at&.strftime("%Y-%m-%d %I:%M %p") %>
      <% end %>
      <% if @event.length_in_minutes.present? %>
        (total length: <%= @event.length_in_minutes %> minutes)
      <% end %>
    </p>

    <%= form_with url: new_subevents_path, method: :post, local: true do |form| %>
      <div class="mb-4">
        <%= form.label :subevent_title, class: CssClass::LABEL do %>
          Subevent Title
          <span class="text-sm font-light">(keep same as parent event to generate numbered subevents)</span>
        <% end %>
        <%= form.text_field :subevent_title, value: @event.title, class: CssClass::TEXT_FIELD %>
      </div>

      <div class="mb-4">
        <%= form.label :number_of_subevents, "Number of subevents", class: CssClass::LABEL %>
        <%= form.number_field :number_of_subevents, min: 1, class: CssClass::NUMBER_FIELD_INLINE %>
      </div>

      <div class="mb-4">
        <%= form.label :same_times, "Each subevent will use the same start/end times as #{@event.title}?", class: CssClass::LABEL %>
        <%= form.check_box :same_times, class: CssClass::CHECK_BOX, "x-model" => "sameTimes" %>
      </div>

      <div x-show="!sameTimes">
        <div class="mb-4">
          <%= form.label :length_of_each_subevent, "Length of each subevent (in minutes)", class: CssClass::LABEL %>
          <%= form.number_field :length_of_each_subevent, min: 1, class: CssClass::NUMBER_FIELD_INLINE %>
        </div>

        <div class="mb-4">
          <%= form.label :length_of_break, "Length of break between subevents (in minutes)", class: CssClass::LABEL %>
          <%= form.number_field :length_of_break, min: 0, class: CssClass::NUMBER_FIELD_INLINE %>
        </div>
      </div>

      <div class="mb-4">
        <%= form.label :attach_submissions, "Automatically attach approved submissions to each event?", class: CssClass::LABEL %>
        <%= form.check_box :attach_submissions, class: CssClass::CHECK_BOX %>
      </div>

      <div class="flex items-center justify-between">
        <%= form.submit "Create Subevents", class: "bg-blue-500 hover:bg-blue-700 text-white py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
        <%= link_to "Back to event", @event, class: "mt-2 ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block" %>
      </div>
    <% end %>
</div>
