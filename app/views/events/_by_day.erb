<% events.sort_by { |e| e.starts_at }.group_by { |event| event.starts_at.strftime("%a, %B %d") }.each do |day, day_events| %>
    <h3 class="font-bold text-xl my-4"><%= day %></h3>
    <%= render partial: "events/events_list", locals: { collection: @collection, events: day_events, depth: depth } %>
<% end %>
