<% content_for :title, "New Event" %>
<% content_for :breadcrumb do %>
  <%= render partial: "breadcrumb", locals: { collection: @event.collection, action: "New" } %>
<% end %>
<% content_for :description do %>
  <div class="flex items-center gap-1">
    <span class="size-8 inline-block mr-1">
      <%= link_to collection_events_path(@event.collection) do %>
          <%= render IconComponent.new(:calendar) %>
      <% end %>
    </span>
    <span>New <span class="font-normal">Event</span></span>
  </div>
<% end %>

<%= render "form", event: @event %>
