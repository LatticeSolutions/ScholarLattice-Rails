<%= tag.div class: "p-2 my-2 rounded-md border border-gray-300", style: event.collection.inherited(:item_html_style) do %>
    <div>
        <% unless base_collection&.relative_crumbs(event.collection).empty? %>
            <%= tag.div class: "text-xs flex gap-1", style: event.collection.inherited(:text_html_style) do %>
                <%= render BreadcrumbsComponent.new(*base_collection.relative_crumbs(event.collection, true)) %>
            <% end %>
        <% end %>
        <div>
        <%= link_to event, class: "text-blue-600 hover:underline font-bold", style: event.collection.inherited(:link_html_style) do %>
            <%= event.title %>
            <% if event.inherited(:location).present? %>
                <%= tag.span class: "text-sm font-normal", style: event.collection.inherited(:text_html_style) do %>
                    in <span class="font-semibold"><%= event.inherited(:location) %></span>
                <% end %>
            <% end %>
        <% end %>
        <% if event.webinar_link.present? && can?(:access_webinar, event) %>
            <%= link_to event_webinar_path(event), 
                class: "inline-block bg-purple-600 hover:bg-purple-700 text-white font-semibold px-1 py-1 rounded transition-colors duration-150 ml-2", 
                target: "_blank", 
                rel: "noopener" do %>
                <span class="inline-block size-4">
                    <%= render IconComponent.new(:video) %>
                </span>
            <% end %>
        <% end %>
        </div>
    </div>
    <% if event.submission.present? %>
        <%= tag.div style: event.collection.inherited(:text_html_style) do %>
            <span class="italic mathjax"><%= event.submission.title %></span>
            &mdash;
            <%= event.submission.author_list.present? ? event.submission.author_list : event.submission.user.name %>
        <% end %>
    <% end %>
    <% if event.children.present? %>
        <% if depth.nil? || depth > 0 %>
            <div class="my-4">
                <%= render partial: "events/events_list", locals: { 
                    base_collection: base_collection,
                    collection: event.collection,
                    events: event.children,
                    parent_times: event.times_in_time_zone_short,
                    depth: depth.nil? ? nil : depth - 1,
                    inner_style: true
                } %>
            </div>
        <% end %>
    <% end %>
<% end %>
