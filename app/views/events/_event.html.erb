<div id="<%= dom_id event %>">
    <% if event.parent.present? %>
      <div class="text-sm text-gray-400 md:text-base mb-8 text-center">
            Subevent of <%= link_to event.parent.title, event.parent, class: "text-blue-400 hover:text-blue-500 hover:underline" %>
      </div>
    <% end %>

    <% if event.submission.present? %>
      <h3 class="text-xl text-gray-900 md:text-2xl my-4">
            <%= event.submission.title_info %>
            <% if can? :manage, event.submission %>
              <%= link_to "[Edit Submission]", edit_submission_path(event.submission), class: "text-base text-blue-600 hover:text-blue-500 hover:underline" %>
            <% end %>
      </h3>
        <%= render event.submission %>
    <% elsif event.content.present? %>
        <div class="mathjax prose sm:prose-xl prose-a:text-blue-600 hover:prose-a:text-blue-500 prose-a:no-underline">
         <%= sanitize event.to_html(:content) %>
      </div>
    <% end %>

    <% if event.inherited(:webinar_link).present? and can? :access_webinar, event %>
      <p class="my-5">
        <strong class="block font-medium mb-1">Webinar link:</strong>
        <%= link_to event_webinar_path(event), target: "_blank", class: "inline-flex items-center gap-2 rounded-md bg-purple-600 px-2 py-1 text-base text-white shadow-sm hover:bg-purple-700 focus:outline-none focus:ring focus:ring-purple-400 break-all" do %>
          <span class="inline-block size-3">
              <%= render IconComponent.new(:video) %>
          </span>
          Webinar
        <% end %>
      </p>
    <% end %>
</div>
