<%= form.fields_for :user, new_registration.user do |user_fields| %>
  <%= render "users/fields_for",
      user: new_registration.user,
      email_disabled: true,
      form: user_fields %>
<% end %>

<%= form.hidden_field :user_id, value: new_registration.user_id %>

<h2 class="font-bold text-2xl">Registration Info</h2>

<div class="my-5">
  <%= render "errors", object: new_registration, attribute: :user %>

  <%= render "errors", object: new_registration, attribute: :registration_option_choices %>

  <div x-data="{ limitOne: <%= 
    new_registration.collection.limit_one_registration_option? ? "true" : "false" 
    %>, selectedOption: '<%= 
    new_registration.registration_option_choices.select{|c| c.amount > 0}.first&.registration_option_id || "null" 
    %>' }">
    <% if new_registration.collection.limit_one_registration_option? %>
      <div class="mb-5">
        <%= label_tag :registration_option_id_choice, "Registration Option", class: CssClass::LABEL %>
        <%= select_tag :registration_option_id_choice, 
          options_for_select(new_registration.collection.registration_options.map{|ro| [ro.name, ro.id]}),
          {
            prompt: "Select an option",
            value: new_registration.registration_option_choices.select{|c| c.amount > 0}.first&.registration_option_id,
            class: CssClass::SELECT,
            "x-model" => "selectedOption"
          } %>
      </div>
    <% end %>

    <%= form.fields_for :registration_option_choices do |choice_fields| %>
      <div :class="{ 'hidden' : limitOne && selectedOption !== '<%= choice_fields.object.registration_option_id %>' }">
        <% if choice_fields.object.registration_option.limit_one_per_registration %>
          <% if new_registration.collection.limit_one_registration_option %>
            <%= choice_fields.hidden_field :amount, value: 1 %>
          <% else %>
            <div class="mb-5">
              <%= choice_fields.label :amount, class: CssClass::LABEL do %>
                <%= choice_fields.object.registration_option.name %> Registration
              <% end %>
              <%= choice_fields.check_box :amount, class: CssClass::CHECK_BOX %>
              <%= render "errors", object: choice_fields.object, attribute: :amount %>
            </div>
          <% end %>
        <% else %>
          <div class="mb-5">
            <%= choice_fields.label :amount, class: CssClass::LABEL do %>
                <%= choice_fields.object.registration_option.name %> Amount
            <% end %>
            <%= choice_fields.number_field :amount, class: CssClass::NUMBER_FIELD %>
            <%= render "errors", object: choice_fields.object, attribute: :amount %>
          </div>
        <% end %>
        <% if choice_fields.object.registration_option.info_prompt.present? %>
          <div class="mb-5">
            <%= choice_fields.label :info, class: CssClass::LABEL do %>
              <%= choice_fields.object.registration_option.name %> Info
              <span class="<%= CssClass::SUBLABEL %>">
                <%= choice_fields.object.registration_option.info_prompt %>
              </span>
            <% end %>
            <%= choice_fields.text_field :info, class: CssClass::TEXT_FIELD %>
            <%= render "errors", object: choice_fields.object, attribute: :info %>
          </div>
        <% else %>
          <%= choice_fields.hidden_field :info %>
        <% end %>
        <%= choice_fields.hidden_field :registration_option_id %>
      </div>
    <% end %>
  </div>

</div>

<% if can? :manage, collection %>
  <div class="my-5">
    <%= form.label :status, class: CssClass::LABEL do %>
      <span class="size-4 inline-block">
        <%= render IconComponent.new(:key) %>
      </span>
      Status
    <% end %>
    <%= form.select :status, NewRegistration.statuses.keys.map {|key| [key.humanize, key]},
      {selected: new_registration.status || :submitted},
      {class: CssClass::SELECT} %>
    <%= render "errors", object: new_registration, attribute: :status %>
  </div>
<% end %>
