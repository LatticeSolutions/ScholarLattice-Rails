<% content_for :title, "New Registration | #{@collection.title}" %>

<div class="mx-auto md:w-2/3 w-full">

  <%= render partial: "breadcrumb", locals: { collection: @collection, action: "New" } %>

  <h1 class="font-bold text-4xl">
    New Registration for <%= link_to @collection.title, @collection, class: "text-blue-600 hover:underline" %>
  </h1>
  <p class="text-lg font-light">
      <%= @collection.description %>
  </p>

  <% if can? :manage, @new_registration.collection %>
    <%= render "users/change_form", user: @new_registration.user, url: collection_new_registrations_path(@new_registration.collection), method: :post %>
  <% end %>

  <%= render "form", new_registration: @new_registration, collection: @collection %>
</div>
