<% if @submission.user.mailkick_subscribed?("site_emails") %>
    <% content_for :footer do %>
        <br><%= link_to "Unsubscribe", mailkick_unsubscribe_url(@submission.user, "site_emails") %>
    <% end %>
<% end %>

<h1><%= @submission.collection.root.title %>: Submission Updated for <%= @submission.collection.title %></h1>
<p>
    The submission titled "<%= link_to @submission.title, submission_url(@submission) %>" 
    for <%= link_to @submission.collection.title, collection_url(@submission.collection) %>
    has been updated on ScholarLattice. Its status is currently "<%= @submission.status %>".
    Visit <%= link_to 'this link', submission_url(@submission) %> to see the submission.
</p>
