<% content_for :title, "#{@page.title} | #{@page.collection.title}" %>
<% if can? :manage, @page %>
    <% @buttons = [[
            "Admin",
            :key,
            true,
            {icon: :edit, path: edit_page_path(@page), text: "Edit"},
        { 
            path: @page, 
            text: "Delete page",
            method: :delete,
            confirm: "Are you sure you want to delete this page?",
            hidden: (cannot? :destroy, @page),
            styles: "text-red-800"
        },
    ]] %>
<% end %>
<% content_for :description do %>
    <div class="flex items-center">
        <span class="size-8 inline-block mx-1">
            <%= render IconComponent.new(:page) %>
        </span>
        <span>
            <%= @page.title %>
        </span>
    </div>
<% end %>
<% content_for :breadcrumb do %>
  <%= render "breadcrumb", page: @page %>
<% end %>

<%= render @page %>
