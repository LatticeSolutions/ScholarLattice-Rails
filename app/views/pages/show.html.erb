<% content_for :title, "#{@page.title} | #{@page.collection.title}" %>
<% content_for :title_header do %>
    <%= link_to @collection.title, @collection, class: "hover:underline" %>
<% end %>
<% if can? :manage, @page %>
    <% content_for :title_buttons do %>
        <%= render MenuToggleComponent.new(
            "Admin",
            :key,
            true,
            {icon: :edit, path: edit_page_path(@page), text: "Edit"},
        ) %>
    <% end %>
<% end %>
<% content_for :description do %>
    <%= @page.title %>
<% end %>
<% content_for :breadcrumb do %>
  <%= render "breadcrumb", page: @page %>
<% end %>

<div class="mx-auto md:w-2/3 w-full">
    <%= render @page %>
    <div class="my-8">
        <%= link_to "« Back to #{@page.collection.short_title}", @page.collection,
            class: "text-sky-600 hover:text-sky-800 hover:underline" %>
    </div>
</div>
