<% content_for :title, "New Page" %>
<% content_for :title_header do %>
    <%= link_to @collection.title, @collection, class: "hover:underline" %>
<% end %>
<% content_for :description do %>
    New Page
<% end %>
<% content_for :breadcrumb do %>
  <%= render "breadcrumb", page: @page, action: "New" %>
<% end %>
  
<div class="mx-auto md:w-3/4 w-full">
  <%= render "form", page: @page, cancel_path: @page %>
</div>
